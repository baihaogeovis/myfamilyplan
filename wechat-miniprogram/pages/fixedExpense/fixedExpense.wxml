<view class="page-container">

  <!-- 概览 -->
  <view class="card overview-card" wx:if="{{overview}}">
    <view class="ov-item">
      <view class="ov-label">月度固定支出</view>
      <view class="ov-value">¥{{overview.monthlyAmount}}</view>
    </view>
    <view class="ov-item">
      <view class="ov-label">已记录笔数</view>
      <view class="ov-value">{{overview.recordCount}}</view>
    </view>
    <view class="ov-item">
      <view class="ov-label">预算占比</view>
      <view class="ov-value">{{overview.budgetPercent}}%</view>
    </view>
  </view>

  <view class="card list-header">
    <view class="card-title">固定支出项目</view>
    <view class="header-desc">每期自动计入支出</view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty-state">
    <view class="empty-icon">📦</view>
    <view class="empty-text">暂无固定支出项目</view>
  </view>

  <view class="card fe-item" wx:for="{{list}}" wx:key="id" bindtap="openEdit" data-item="{{item}}">
    <view class="fe-info">
      <view class="fe-name">{{item.expenseName}}</view>
      <view class="fe-meta">
        <text class="tag tag-orange">{{item.category}}</text>
        <text class="tag {{item.active ? 'tag-green' : 'tag-gray'}}">{{item.activeText}}</text>
        <text class="fe-day">每月{{item.dueDay}}日</text>
      </view>
    </view>
    <view class="fe-right">
      <view class="fe-amount">¥{{item.amountText}}</view>
      <view class="fe-actions">
        <text class="fe-toggle" catchtap="toggleActive" data-item="{{item}}">{{item.active ? '停用' : '启用'}}</text>
        <text class="fe-del" catchtap="removeItem" data-item="{{item}}">删除</text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="openAdd">+</view>

  <!-- 弹窗 -->
  <view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="modal-body" catchtap="noop">
      <view class="modal-title">{{formMode === 'add' ? '新增' : '编辑'}}固定支出</view>

      <view class="form-item">
        <text class="form-label">项目名称</text>
        <input class="form-input" placeholder="如：物业费" placeholder-class="form-placeholder"
          value="{{form.expenseName}}" bindinput="onName" />
      </view>

      <view class="form-item">
        <text class="form-label">分类</text>
        <view class="category-row">
          <view class="category-chip {{form.category === item ? 'active' : ''}}"
            wx:for="{{categories}}" wx:key="*this" wx:for-item="item"
            bindtap="chooseCategory" data-cat="{{item}}">{{item}}</view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">金额</text>
        <input class="form-input" type="digit" placeholder="请输入金额" placeholder-class="form-placeholder"
          value="{{form.amount}}" bindinput="onAmount" />
      </view>

      <view class="form-item">
        <text class="form-label">缴费日</text>
        <picker mode="selector" range="{{days}}" bindchange="onDueDay">
          <view class="form-input">每月{{form.dueDay}}日</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="备注（选填）" placeholder-class="form-placeholder"
          value="{{form.remark}}" bindinput="onRemark" />
      </view>

      <button class="btn-primary modal-btn" bindtap="submitForm">保存</button>
    </view>
  </view>
</view>
