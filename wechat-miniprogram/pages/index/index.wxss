.overview-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 600;
}

.overview-member {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.overview-row {
  display: flex;
}

.overview-item {
  flex: 1;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.overview-value {
  font-size: 34rpx;
  font-weight: 700;
}

.overview-value.income {
  color: #67e8b9;
}

.overview-value.expense {
  color: #ffd3d3;
}

.overview-footer {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.overview-stat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-right: 32rpx;
}

/* 快捷记账 */
.quick-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.quick-btn.income {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #0a6b42;
}

.quick-btn.expense {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #7a2a3f;
}

/* 功能菜单 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
}

.menu-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.menu-name {
  font-size: 24rpx;
  color: #606266;
}

/* 最近收支 */
.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-name {
  font-size: 28rpx;
  color: #303133;
}

.recent-desc {
  font-size: 22rpx;
  color: #909399;
  margin-top: 4rpx;
}

.recent-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.recent-amount.income {
  color: #67c23a;
}

.recent-amount.expense {
  color: #f56c6c;
}
