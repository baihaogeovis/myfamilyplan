.hello {
  margin: 8rpx 8rpx 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #1c2822;
  font-family: "Songti SC", "STSong", serif;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  width: calc(50% - 8rpx);
  background: #fffcf8;
  border: 2rpx solid #e6dfd2;
  border-radius: 28rpx;
  padding: 24rpx 22rpx 22rpx;
  box-sizing: border-box;
}

.stat-k {
  font-size: 24rpx;
  color: #E85D4C;
  letter-spacing: 2rpx;
}

.stat-v {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1c2822;
}

.stat-s {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8175;
}

.next-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f3efe6;
}

.next-item:last-child {
  border-bottom: none;
}

.next-kind {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #E85D4C;
  font-weight: 600;
}

.next-title {
  font-size: 30rpx;
  color: #1c2822;
  font-weight: 600;
}

.next-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8175;
}

.next-empty {
  padding: 12rpx 8rpx 8rpx;
}

.next-empty .empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c2822;
  font-family: "Songti SC", "STSong", serif;
}

.next-empty .empty-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8175;
  line-height: 1.5;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.empty-btn {
  flex: 1;
  text-align: center;
  background: #E85D4C;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.empty-btn.ghost {
  background: #fffcf8;
  color: #E85D4C;
  border: 2rpx solid #f0b2a8;
}
