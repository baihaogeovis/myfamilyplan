.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 120rpx 48rpx 0;
}

.login-hero {
  text-align: center;
  margin-bottom: 80rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.app-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.mode-tabs {
  display: flex;
  margin-bottom: 32rpx;
  background: #f0f2f5;
  border-radius: 40rpx;
  padding: 8rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #909399;
  border-radius: 36rpx;
  transition: all 0.2s;
}

.mode-tab.active {
  background: #ffffff;
  color: #667eea;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.login-btn {
  margin-top: 48rpx;
}

.login-footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
