<view class="page-container">

  <view wx:if="{{list.length === 0}}" class="empty-state">
    <view class="empty-icon">👨‍👩‍👧‍👦</view>
    <view class="empty-text">暂无家庭成员，点击下方按钮添加</view>
  </view>

  <view class="family-lead">点一个人，今天就以这位家人的身份来看。</view>

  <view class="member-grid">
  <view class="card member-item" wx:for="{{list}}" wx:key="id">
    <view class="member-avatar">{{item.memberName[0]}}</view>
    <view class="member-info" bindtap="openEdit" data-item="{{item}}">
      <view class="member-name">{{item.memberName}}</view>
      <view class="member-meta">
        <text class="tag tag-green">{{item.roleText}}</text>
        <text class="tag tag-gray">{{item.relationText}}</text>
      </view>
      <view class="member-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
    </view>
    <view class="member-side">
      <view class="member-now" catchtap="setCurrent" data-item="{{item}}">{{currentId === item.id ? '正在用' : '设为当前'}}</view>
      <view class="member-del" catchtap="removeItem" data-item="{{item}}">删除</view>
    </view>
  </view>
  </view>

  <view class="fab" bindtap="openAdd">+</view>

  <!-- 弹窗 -->
  <view class="modal-mask {{showForm ? '' : 'is-closing'}}" wx:if="{{showForm || modalHold}}" catchtap="closeForm">
    <view class="modal-body" wx:if="{{showForm}}" catchtap="noop">
      <view class="modal-title">{{formMode === 'add' ? '新增' : '编辑'}}成员</view>

      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入姓名" placeholder-class="form-placeholder"
          value="{{form.memberName}}" bindinput="onName" />
      </view>

      <view class="form-item">
        <text class="form-label">关系</text>
        <view class="chip-row">
          <view class="chip {{form.relation === 'OWNER' ? 'active' : ''}}" bindtap="chooseRelation" data-value="OWNER">户主</view>
          <view class="chip {{form.relation === 'SPOUSE' ? 'active' : ''}}" bindtap="chooseRelation" data-value="SPOUSE">配偶</view>
          <view class="chip {{form.relation === 'CHILD' ? 'active' : ''}}" bindtap="chooseRelation" data-value="CHILD">子女</view>
          <view class="chip {{form.relation === 'PARENT' ? 'active' : ''}}" bindtap="chooseRelation" data-value="PARENT">父母</view>
          <view class="chip {{form.relation === 'OTHER' ? 'active' : ''}}" bindtap="chooseRelation" data-value="OTHER">其他</view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="选填" placeholder-class="form-placeholder"
          value="{{form.phone}}" bindinput="onPhone" />
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="备注（选填）" placeholder-class="form-placeholder"
          value="{{form.remark}}" bindinput="onRemark" />
      </view>

      <button class="btn-primary modal-btn" bindtap="submitForm">保存</button>
    </view>
  </view>
</view>
