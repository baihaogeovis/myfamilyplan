.date-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-picker {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.date-stats {
  font-size: 26rpx;
  color: #909399;
}

.date-stats .num {
  color: #67c23a;
  font-weight: 700;
}

.type-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #909399;
  border-radius: 12rpx;
}

.type-tab.active {
  background: #667eea;
  color: #ffffff;
  font-weight: 600;
}

.task-item {
  display: flex;
  align-items: center;
}

.task-item.done .task-name {
  text-decoration: line-through;
  color: #c0c4cc;
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #dcdfe6;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #ffffff;
}

.task-check.checked {
  background: #67c23a;
  border-color: #67c23a;
}

.task-main {
  flex: 1;
}

.task-name {
  font-size: 30rpx;
  color: #303133;
  font-weight: 500;
}

.task-meta {
  margin-top: 10rpx;
  display: flex;
  gap: 12rpx;
}

.task-remark {
  font-size: 24rpx;
  color: #909399;
  margin-top: 8rpx;
}

.task-del {
  font-size: 24rpx;
  color: #f56c6c;
  padding: 16rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.5);
  z-index: 20;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-body {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.chip-row {
  flex: 1;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #f4f4f5;
  color: #606266;
  border: 2rpx solid transparent;
}

.chip.active {
  background: #667eea;
  color: #ffffff;
  border-color: #667eea;
}

.modal-btn {
  margin-top: 40rpx;
}
