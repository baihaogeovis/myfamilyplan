/**
 * 全局样式
 */
page {
  background: #f6f1e8;
  font-size: 28rpx;
  color: #3c4740;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

/* 通用容器 */
.plan-jump {
  margin-bottom: 16rpx;
  color: #E85D4C;
  font-size: 26rpx;
  font-weight: 600;
}

.page-container {
  padding: 24rpx 24rpx calc(24rpx + 140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(48, 36, 18, 0.05);
  transition: transform 0.15s ease;
}

.card:active {
  transform: scale(0.985);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2822;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 16rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #c46a45;
}

/* 按钮 */
.btn-primary {
  background: #E85D4C;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 79, 0.2);
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: #ffffff;
  color: #E85D4C;
  border: 2rpx solid #E85D4C;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  width: 100%;
}

.btn-plain::after {
  border: none;
}

button[disabled] {
  opacity: 0.5;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
  color: #c0c4cc;
}

.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  font-size: 26rpx;
  color: #909399;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #606266;
  flex-shrink: 0;
  font-weight: 500;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #303133;
}

.form-placeholder {
  color: #c0c4cc;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 500;
}

.tag-green {
  background: #e1f3d8;
  color: #529b2e;
}

.tag-red {
  background: #fde2e2;
  color: #e04b4b;
}

.tag-blue {
  background: #d9ecff;
  color: #337ecc;
}

.tag-purple {
  background: #ece3ff;
  color: #6a3de8;
}

.tag-orange {
  background: #fdf6ec;
  color: #b88230;
}

.tag-gray {
  background: #f4f4f5;
  color: #73767a;
}

/* 底部安全区 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E85D4C;
  color: #ffffff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(47, 107, 79, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(47, 107, 79, 0.3);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-body {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c2822;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-btn {
  margin-top: 24rpx;
}

/* 分类选择器 */
.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #f5f7fa;
  color: #606266;
  transition: all 0.2s;
}

.category-chip.active {
  background: #E85D4C;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(47, 107, 79, 0.3);
}

/* 类型切换 */
.type-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #909399;
  font-weight: 500;
  transition: all 0.25s;
}

.type-tab.active {
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 79, 0.3);
}

.type-tab.active.income {
  background: linear-gradient(135deg, #67c23a, #85ce61);
}

.type-tab.active.expense {
  background: linear-gradient(135deg, #e6a23c, #f0c78a);
}
