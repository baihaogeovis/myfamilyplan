/**
 * 全局样式
 */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #303133;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

/* 通用容器 */
.page-container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 20rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  width: 100%;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: #ffffff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  width: 100%;
}

.btn-plain::after {
  border: none;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: #c0c4cc;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-state .empty-text {
  font-size: 26rpx;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #606266;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #303133;
}

.form-placeholder {
  color: #c0c4cc;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-green {
  background: #e1f3d8;
  color: #67c23a;
}

.tag-red {
  background: #fde2e2;
  color: #f56c6c;
}

.tag-blue {
  background: #d9ecff;
  color: #409eff;
}

.tag-purple {
  background: #ece3ff;
  color: #7c4dff;
}

.tag-orange {
  background: #fdf6ec;
  color: #e6a23c;
}

.tag-gray {
  background: #f4f4f5;
  color: #909399;
}

/* 底部安全区 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
