.family-card {
  background: #fffcf8;
  color: #1c2822;
  position: relative;
  border: 2rpx solid #e6dfd2;
}

.family-name {
  font-size: 48rpx;
  font-weight: 600;
  font-family: "Songti SC", "STSong", serif;
  padding-right: 160rpx;
}

.family-meta {
  font-size: 24rpx;
  color: #6e776f;
  margin-top: 12rpx;
}

.member-switch {
  position: absolute;
  right: 24rpx;
  top: 32rpx;
  font-size: 24rpx;
  color: #E85D4C;
  background: #FDE8E4;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.member-item:last-child {
  border-bottom: none;
}

.member-item.active {
  background: rgba(47, 107, 79, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
}

.member-item:nth-child(6n+1) .member-avatar { background: #e7f2ea; color: #1f6b45; }
.member-item:nth-child(6n+2) .member-avatar { background: #f8e6dc; color: #9a4a2c; }
.member-item:nth-child(6n+3) .member-avatar { background: #e5f3f8; color: #0b7285; }
.member-item:nth-child(6n+4) .member-avatar { background: #fff1d4; color: #8a5a08; }
.member-item:nth-child(6n+5) .member-avatar { background: #efe8fb; color: #5b3fb0; }
.member-item:nth-child(6n+6) .member-avatar { background: #fde8e6; color: #9b3328; }

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #e7f2ea;
  color: #1f6b45;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 30rpx;
  color: #303133;
  font-weight: 500;
}

.member-relation {
  font-size: 22rpx;
  color: #909399;
  margin-top: 4rpx;
}

.member-check {
  color: #E85D4C;
  font-size: 32rpx;
  font-weight: 700;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #303133;
}

.setting-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}

.logout-btn {
  margin-top: 40rpx;
  color: #f56c6c;
  border-color: #f56c6c;
  background: #ffffff;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-body {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-btn {
  margin-top: 40rpx;
}
