<view class="page-container">

  <!-- 家庭信息 -->
  <view class="card family-card">
    <view class="family-name">{{family.familyName || '我的家庭'}}</view>
    <view class="family-meta">
      账号：{{family.username}} · 家庭成员 {{members.length}} 人
    </view>
    <view class="member-switch" onTap="goMembers">管理成员 ›</view>
  </view>

  <!-- 当前成员选择 -->
  <view class="card">
    <view class="card-title">现在是谁在用</view>
    <view class="member-list">
      <view class="member-item {{currentMemberId === item.id ? 'active' : ''}}"
        a:for="{{members}}" a:key="id"
        onTap="chooseMember" data-id="{{item.id}}" data-name="{{item.memberName}}">
        <view class="member-avatar">{{item.memberName[0]}}</view>
        <view class="member-info">
          <view class="member-name">{{item.memberName}}</view>
          <view class="member-relation">{{item.relation || '成员'}}</view>
        </view>
        <view class="member-check" a:if="{{currentMemberId === item.id}}">✓</view>
      </view>
      <view a:if="{{members.length === 0}}" class="empty-state">
        <view class="empty-text" onTap="goMembers">暂无成员，点击添加 ›</view>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="card">
    <view class="card-title">设置</view>
    <view class="setting-item" onTap="openPwd">
      <view class="setting-label">修改密码</view>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" onTap="goMembers">
      <view class="setting-label">家庭</view>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" onTap="goNotes">
      <view class="setting-label">通知</view>
      <view class="setting-arrow">›</view>
    </view>
  </view>

  <button class="btn-plain logout-btn" onTap="logout">退出登录</button>
  <view class="safe-bottom"></view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask {{showPwd ? '' : 'is-closing'}}" a:if="{{showPwd || modalHold}}" catchTap="closePwd">
    <view class="modal-body" a:if="{{showPwd}}" catchTap="noop">
      <view class="modal-title">修改密码</view>
      <view class="form-item">
        <text class="form-label">原密码</text>
        <input class="form-input" password placeholder="请输入原密码" placeholder-class="form-placeholder"
          value="{{pwdForm.oldPassword}}" onInput="onOldPwd" />
      </view>
      <view class="form-item">
        <text class="form-label">新密码</text>
        <input class="form-input" password placeholder="请输入新密码" placeholder-class="form-placeholder"
          value="{{pwdForm.newPassword}}" onInput="onNewPwd" />
      </view>
      <button class="btn-primary modal-btn" onTap="submitPwd">确认修改</button>
    </view>
  </view>
</view>
