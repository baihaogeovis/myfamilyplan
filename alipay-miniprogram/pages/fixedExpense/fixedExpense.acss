.overview-card {
  display: flex;
  background: linear-gradient(135deg, #5b8ff9 0%, #9254de 100%);
  color: #ffffff;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.ov-value {
  font-size: 32rpx;
  font-weight: 700;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.header-desc {
  font-size: 22rpx;
  color: #c0c4cc;
}

.fe-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fe-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.fe-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.fe-day {
  font-size: 22rpx;
  color: #909399;
}

.fe-right {
  text-align: right;
}

.fe-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #e6a23c;
}

.fe-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
  justify-content: flex-end;
}

.fe-toggle {
  font-size: 22rpx;
  color: #E85D4C;
}

.fe-del {
  font-size: 22rpx;
  color: #f56c6c;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E85D4C;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, 0.5);
  z-index: 20;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-body {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.category-row {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
}

.category-chip {
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #f4f4f5;
  color: #606266;
  border: 2rpx solid transparent;
}

.category-chip.active {
  background: #E85D4C;
  color: #ffffff;
  border-color: #E85D4C;
}

.modal-btn {
  margin-top: 40rpx;
}
