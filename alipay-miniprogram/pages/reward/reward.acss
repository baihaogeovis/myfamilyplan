/* 孩子切换 */
.child-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.child-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid transparent;
}

.child-chip.active {
  border-color: #188043;
  background: #f0edff;
}

.child-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #a3d93f 0%, #2fae52 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.child-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #606266;
}

/* 额度概览 */
.balance-card {
  background: linear-gradient(140deg, #2fae52 0%, #146536 100%);
  box-shadow: 0 12rpx 28rpx rgba(20, 101, 54, 0.30);
}

.balance-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.balance-period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.grant-btn {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
}

.balance-num {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}

.balance-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.balance-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.grid-item {
  flex: 1;
  text-align: center;
}

.grid-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.grid-num.blue {
  color: #cddcff;
}

.grid-num.green {
  color: #bdf0cd;
}

.grid-num.red {
  color: #ffcfce;
}

.grid-num.orange {
  color: #ffe4b5;
}

.grid-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 分段 */
.type-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #909399;
  border-radius: 12rpx;
  position: relative;
}

.type-tab.active {
  background: #188043;
  color: #ffffff;
  font-weight: 600;
}

.tab-badge {
  margin-left: 4rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #f56c6c;
  color: #ffffff;
  font-size: 20rpx;
}

.tip-line {
  font-size: 22rpx;
  color: #909399;
  padding: 0 8rpx 16rpx;
}

/* 方案卡片 */
.item-card {
  padding: 24rpx;
}

.item-head {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.item-mid {
  flex: 1;
  padding: 0 18rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}

.item-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #909399;
}

.item-cost {
  text-align: right;
}

.cost-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #f56c6c;
}

.cost-num.gain {
  color: #188043;
}

.cost-unit {
  font-size: 22rpx;
  color: #909399;
  margin-left: 4rpx;
}

.cost-steps {
  display: block;
  font-size: 20rpx;
  color: #b45309;
}

.item-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f6fa;
}

.item-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lack {
  font-size: 22rpx;
  color: #f56c6c;
}

.ok {
  font-size: 22rpx;
  color: #188043;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 28rpx;
  overflow: hidden;
}

.step-btn {
  width: 60rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #188043;
}

.step-val {
  min-width: 110rpx;
  text-align: center;
  font-size: 24rpx;
  color: #606266;
}

.step-input {
  width: 110rpx;
  height: 56rpx;
  text-align: center;
  font-size: 24rpx;
}

/* 按钮 */
.mini-btn {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #f4f4f5;
  color: #606266;
}

.mini-btn.primary {
  background: #188043;
  color: #ffffff;
}

.mini-btn.done {
  background: #188043;
  color: #ffffff;
}

.mini-btn.cancel {
  background: #fdf6ec;
  color: #b45309;
}

.mini-btn.edit {
  background: #f0f9ff;
  color: #409eff;
}

.mini-btn.del {
  background: #fef0f0;
  color: #f56c6c;
}

/* 流水 */
.txn-card {
  padding: 24rpx;
}

.txn-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.txn-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}

.txn-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #909399;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.txn-pts {
  font-size: 28rpx;
  font-weight: 700;
}

.txn-pts.cost {
  color: #f56c6c;
}

.txn-pts.gain {
  color: #188043;
}

.txn-pts.expire,
.txn-pts.neutral {
  color: #909399;
}

.txn-ops {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.more-btn {
  text-align: center;
  padding: 22rpx;
  font-size: 24rpx;
  color: #188043;
}

/* 表单 */
.chip-row {
  flex: 1;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.chip-row.wrap {
  flex-wrap: wrap;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #f4f4f5;
  color: #606266;
  border: 2rpx solid transparent;
}

.chip.active {
  background: #188043;
  color: #ffffff;
  border-color: #188043;
}

.mini-tip {
  font-size: 22rpx;
  color: #b45309;
  padding-bottom: 16rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f5f6fa;
}

.plan-name {
  font-size: 26rpx;
  color: #303133;
  font-weight: 600;
}

.plan-sub {
  flex: 1;
  padding-left: 16rpx;
  font-size: 22rpx;
  color: #909399;
}

.plan-ops {
  display: flex;
  gap: 10rpx;
}

.modal-btn {
  margin-top: 36rpx;
}
