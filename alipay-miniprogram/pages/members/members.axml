<view class="page-container">

  <view a:if="{{loaded && list.length === 0}}" class="family-empty">
    <view class="empty-title">还没有家人</view>
    <view class="empty-text">先把家里人加进来，工作台才知道跟谁过今天</view>
    <view a:if="{{canManage}}" class="empty-btn" onTap="openAdd">添加成员</view>
    <view a:else class="empty-hint">只有家长可以添加或编辑家人</view>
  </view>

  <view class="family-lead">点一个人，今天就以这位家人的身份来看。</view>

  <view class="member-grid">
  <view class="card member-item" a:for="{{list}}" a:key="id">
    <view class="member-avatar">{{item.memberName[0]}}</view>
    <view class="member-info" onTap="openEdit" data-item="{{item}}">
      <view class="member-name">{{item.memberName}}</view>
      <view class="member-meta">
        <text class="tag tag-green">{{item.roleText}}</text>
        <text class="tag tag-gray">{{item.relationText}}</text>
      </view>
      <view class="member-remark" a:if="{{item.remark}}">{{item.remark}}</view>
    </view>
    <view class="member-side">
      <view class="member-now" catchTap="setCurrent" data-item="{{item}}">{{currentId === item.id ? '正在用' : '设为当前'}}</view>
      <view class="member-del" catchTap="removeItem" data-item="{{item}}">删除</view>
    </view>
  </view>
  </view>

  <view a:if="{{list.length > 0}}" class="fab" onTap="openAdd">+</view>

  <!-- 弹窗 -->
  <view class="modal-mask {{showForm ? '' : 'is-closing'}}" a:if="{{showForm || modalHold}}" catchTap="closeForm">
    <view class="modal-body" a:if="{{showForm}}" catchTap="noop">
      <view class="modal-title">{{formMode === 'add' ? '新增' : '编辑'}}成员</view>

      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入姓名" placeholder-class="form-placeholder"
          value="{{form.memberName}}" onInput="onName" />
      </view>

      <view class="form-item">
        <text class="form-label">关系</text>
        <view class="chip-row">
          <view class="chip {{form.relation === 'OWNER' ? 'active' : ''}}" onTap="chooseRelation" data-value="OWNER">户主</view>
          <view class="chip {{form.relation === 'SPOUSE' ? 'active' : ''}}" onTap="chooseRelation" data-value="SPOUSE">配偶</view>
          <view class="chip {{form.relation === 'CHILD' ? 'active' : ''}}" onTap="chooseRelation" data-value="CHILD">子女</view>
          <view class="chip {{form.relation === 'PARENT' ? 'active' : ''}}" onTap="chooseRelation" data-value="PARENT">父母</view>
          <view class="chip {{form.relation === 'OTHER' ? 'active' : ''}}" onTap="chooseRelation" data-value="OTHER">其他</view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="选填" placeholder-class="form-placeholder"
          value="{{form.phone}}" onInput="onPhone" />
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="备注（选填）" placeholder-class="form-placeholder"
          value="{{form.remark}}" onInput="onRemark" />
      </view>

      <button class="btn-primary modal-btn" onTap="submitForm">保存</button>
    </view>
  </view>
</view>
