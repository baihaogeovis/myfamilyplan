<view class="page-container">
  <view class="hero">
    <view class="hero-date">{{dateText}}</view>
    <view class="hero-title">{{greeting}}</view>
    <view class="hero-lede">先看今天的安排，账本放在下面。</view>
    <view class="hero-actions">
      <view class="hero-btn solid" onTap="goMenu" data-path="/pages/workbench/workbench">今日安排</view>
      <view class="hero-btn" onTap="goRecord" data-type="expense">记一笔</view>
    </view>
  </view>

  <view class="card quiet">
    <view class="quiet-head">
      <text class="quiet-title">这个月</text>
      <text class="quiet-meta" a:if="{{overview.memberCount}}">{{overview.memberCount}} 位家人</text>
    </view>
    <view class="quiet-row">
      <view class="quiet-item">
        <view class="quiet-label">收入</view>
        <view class="quiet-value">¥{{overview.monthIncome}}</view>
      </view>
      <view class="quiet-item">
        <view class="quiet-label">支出</view>
        <view class="quiet-value out">¥{{overview.monthExpense}}</view>
      </view>
      <view class="quiet-item">
        <view class="quiet-label">预算还剩</view>
        <view class="quiet-value">¥{{overview.budgetRemaining}}</view>
      </view>
    </view>
    <view class="pending" a:if="{{overview.pendingCount}}" onTap="goMenu" data-path="/pages/approval/approval">
      {{overview.pendingCount}} 笔支出等你点头
    </view>
  </view>

  <view class="card" a:for="{{groups}}" a:key="title">
    <view class="card-title">{{item.title}}</view>
    <view class="group-hint">{{item.hint}}</view>
    <view class="menu-grid">
      <view
        class="menu-item"
        a:for="{{item.items}}"
        a:for-item="menu"
        a:key="name"
        onTap="goMenu"
        data-path="{{menu.path}}"
      >
        <view class="menu-icon tone-{{menu.tone}}">{{menu.icon}}</view>
        <view class="menu-name">{{menu.name}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">最近进出</view>
    <view a:if="{{recent.length === 0}}" class="empty-state">
      <view class="empty-text">还没有流水，先记一笔家里的开销</view>
    </view>
    <view class="recent-item" a:for="{{recent}}" a:key="id">
      <view class="recent-info">
        <view class="recent-name">{{item.categoryText}}</view>
        <view class="recent-desc">{{item.memberName}} · {{item.dateText}}</view>
      </view>
      <view class="recent-amount {{item.type === 'EXPENSE' ? 'expense' : 'income'}}">{{item.amountText}}</view>
    </view>
  </view>
</view>
<main-nav current="work" />
