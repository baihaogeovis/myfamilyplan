<view class="page-container">
  <view class="hello">{{greeting}}</view>

  <view class="stats">
    <view class="stat" onTap="goMenu" data-path="/pages/statistics/statistics">
      <view class="stat-k">结余</view>
      <view class="stat-v">¥{{balanceText}}</view>
      <view class="stat-s">本月收入减支出</view>
    </view>
    <view class="stat" onTap="goMenu" data-path="/pages/approval/approval">
      <view class="stat-k">待审</view>
      <view class="stat-v">{{pendingCount}}</view>
      <view class="stat-s">等你点头的支出</view>
    </view>
    <view class="stat" onTap="goMenu" data-path="/pages/lifePlan/lifePlan">
      <view class="stat-k">计划进度</view>
      <view class="stat-v">{{planProgress}}%</view>
      <view class="stat-s">{{planHint}}</view>
    </view>
    <view class="stat" onTap="goMenu" data-path="/pages/notifications/notifications">
      <view class="stat-k">未读</view>
      <view class="stat-v">{{unread}}</view>
      <view class="stat-s">还没看的通知</view>
    </view>
  </view>

  <view class="card next-card">
    <view class="card-title">接下来</view>
    <view a:if="{{nextList.length === 0}}" class="next-empty">
      <view class="empty-title">接下来还安静</view>
      <view class="empty-text">待审、计划和提醒会排在这里</view>
      <view class="empty-actions">
        <view class="empty-btn" onTap="goMembers">去看看家庭</view>
        <view class="empty-btn ghost" onTap="goRecord" data-type="expense">记一笔</view>
      </view>
    </view>
    <view class="next-item" a:for="{{nextList}}" a:key="key" onTap="goMenu" data-path="{{item.path}}">
      <text class="next-kind">{{item.kind}}</text>
      <view class="next-main">
        <view class="next-title">{{item.title}}</view>
        <view class="next-meta">{{item.meta}}</view>
      </view>
    </view>
  </view>
</view>

