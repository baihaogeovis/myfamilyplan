.main-nav {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 40;
  display: flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.96);
  border: 2rpx solid #e6dfd2;
  box-shadow: 0 12rpx 32rpx rgba(48, 36, 18, 0.12);
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6e776f;
  font-weight: 600;
}

.nav-item.on {
  background: #E85D4C;
  color: #fffdf8;
}
